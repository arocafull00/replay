{
  "name": "replay",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm run dev:local",
    "dev:local": "vercel dev --listen 3000",
    "dev:web": "next dev",
    "build": "node scripts/assets.mjs && next build && node scripts/service-worker.mjs",
    "start": "serve out -l 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-test-module-mocks --test tests/*.test.mjs",
    "db:setup": "node --env-file=.env.local scripts/db-setup.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.4",
    "@clerk/react": "^6.18.3",
    "@neondatabase/serverless": "^1.2.0",
    "@sentry/nextjs": "^11.10.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "mediabunny": "1.61.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "serve": "^14.2.4",
    "sharp": "^0.34.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vercel": "54.15.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild"
    ]
  }
}
